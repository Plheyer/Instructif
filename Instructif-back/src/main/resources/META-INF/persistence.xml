<?xml version="1.0" encoding="UTF-8"?>
<persistence version="2.2" xmlns="http://xmlns.jcp.org/xml/ns/persistence" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/persistence                                  http://xmlns.jcp.org/xml/ns/persistence/persistence_2_2.xsd">
  <persistence-unit name="instructif-PU" transaction-type="RESOURCE_LOCAL">
    <provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>
    <class>com.samtheo.instructif.metier.modele.Eleve</class>
    <class>com.samtheo.instructif.metier.modele.Etablissement</class>
    <class>com.samtheo.instructif.metier.modele.Intervenant</class>
    <class>com.samtheo.instructif.metier.modele.IntervenantEtudiant</class>
    <class>com.samtheo.instructif.metier.modele.IntervenantEnseignant</class>
    <class>com.samtheo.instructif.metier.modele.IntervenantAutre</class>
    <class>com.samtheo.instructif.metier.modele.Matiere</class>
    <class>com.samtheo.instructif.metier.modele.Theme</class>
    <class>com.samtheo.instructif.metier.modele.Demande</class>
    <class>com.samtheo.instructif.metier.modele.Bilan</class>
    <exclude-unlisted-classes>true</exclude-unlisted-classes>
    <properties>
      <property name="javax.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
      <property name="javax.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/DASI-DB?zeroDateTimeBehavior=CONVERT_TO_NULL"/>
      <property name="javax.persistence.jdbc.user" value="dasi"/>
      <property name="javax.persistence.jdbc.password" value="dasi"/>
      <property name="javax.persistence.schema-generation.database.action" value="create"/>
    </properties>
  </persistence-unit>
</persistence>
